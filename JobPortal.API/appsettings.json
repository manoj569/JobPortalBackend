{
  "JobDiscovery": {
    "Enabled": false,
    "RunHourUtc": 2,
    "DefaultCountry": "in",
    "Queries": [ "software", "data" ],
    "Locations": [ "India" ],
    "Providers": [ "Adzuna" ],
    "Adzuna": { "AppId": "", "ApiKey": "" }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=JobPortalDb;Username=postgres;SSL Mode=Disable"
  },
  "Jwt": {
    "Issuer": "JobPortal",
    "Audience": "JobPortal.Client",
    "Key": "CHANGE_THIS_TO_A_SECURE_32_CHARACTER_MINIMUM_SECRET_KEY",
    "AccessTokenLifetimeMinutes": 15
  },
  "Authentication": {
    "Google": {
      "Enabled": false,
      "ClientId": ""
    }
  },
  "Otp": {
    "HashKey": "CHANGE_THIS_TO_A_SECURE_32_CHARACTER_MINIMUM_OTP_HASH_KEY"
  },
  "Sms": {
    "Enabled": false,
    "Provider": "Fast2Sms"
  },
  "Email": {
    "Enabled": false,
    "FromName": "Career Harbor",
    "FromAddress": "no-reply@careerharbor.in",
    "Brevo": {
      "ApiKey": ""
    }
  },
  "AppUrls": {
    "FrontendBaseUrl": "https://careerharbor.in"
  },
  "Razorpay": {
    "KeyId": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT",
    "KeySecret": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT",
    "WebhookSecret": "CONFIGURE_IN_USER_SECRETS_OR_ENVIRONMENT"
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "Email": "",
    "Password": "",
    "FirstName": "",
    "LastName": ""
  },
  "Membership": {
    "DefaultPlan": {
      "Name": "Job Application Access",
      "Amount": 99,
      "CurrencyCode": "INR",
      "DurationDays": 30
    }
  },
  "ResumeStorage": {
    "RootPath": "App_Data/resumes"
  },
  "JobExpiry": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "RunOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.jobportal.example"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/jobportal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
